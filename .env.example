# Скопировать в .env и подставить свои значения. .env в репозиторий не попадает.

# Контактный адрес для вежливого режима OpenAlex.
OPENALEX_MAILTO=your.email@example.com

# Ключ доступа OpenAlex. Бесплатный, выдаётся после регистрации на openalex.org,
# лежит в настройках профиля. Без ключа суточный лимит 1000 запросов, с ключом —
# в десять раз больше, и полная выгрузка укладывается в один день.
OPENALEX_API_KEY=
